DATABASE_URL=postgresql://[user]:[password]@[host]/[database]?sslmode=require
PORT=3000
# Google Gemini API key for AI bill scanning (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
# Optional: pin a specific Gemini model (otherwise current flash models are tried automatically)
# GEMINI_MODEL=gemini-2.5-flash
# Optional: monthly AI spend cap in USD — scanning pauses when reached (default 5)
# AI_MONTHLY_BUDGET_USD=5

# Neon Auth (managed Better Auth) — enable Auth on your Neon project, then
# copy the "Auth URL" from Neon Console -> your project -> Auth
# e.g. https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_URL=your-neon-auth-url
# Optional: only needed if your JWKS URL is not <auth-url>/.well-known/jwks.json
# NEON_AUTH_JWKS_URL=
