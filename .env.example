DATABASE_URL=postgresql://[user]:[password]@[host]/[database]?sslmode=require
PORT=3000
# Google Gemini API key for AI bill scanning (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key
# Optional: pin a specific Gemini model (otherwise current flash models are tried automatically)
# GEMINI_MODEL=gemini-2.5-flash
# Optional: monthly AI spend cap in USD — scanning pauses when reached (default 5)
# AI_MONTHLY_BUDGET_USD=5

# Neon Auth (Stack Auth) — enable Auth on your Neon project and copy these
# from Neon Console -> your project -> Auth -> Configuration
STACK_PROJECT_ID=your-stack-project-id
STACK_PUBLISHABLE_CLIENT_KEY=your-stack-publishable-client-key
